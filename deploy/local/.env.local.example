# 本地替身环境参数（配合 docker-compose.local.yml 使用）
# 用法：python scripts/local_stubs/apply_local_env.py --apply
# 不会覆盖 LLM_BASE_URL / LLM_API_KEY 等已有配置；原 .env 会备份为 .env.bak.local

# --- 1) 真实 IdP / SSO（Keycloak 本地替身）---
AGENT_IDP_PROVIDER=oidc
AGENT_OIDC_ISSUER=http://localhost:8080/realms/ecom-agent
AGENT_OIDC_AUDIENCE=ecom-agent
# 本地 Keycloak 是 http，discovery 只接受 https，所以这里必须显式给 JWKS 地址。
AGENT_OIDC_JWKS_URL=http://localhost:8080/realms/ecom-agent/protocol/openid-connect/certs
AGENT_AUTH_SECRET=local-dev-secret-change-me
AGENT_RBAC_ENABLED=1
AGENT_STAFF_ACCOUNTS=agent01:pwd:agent:u_1001;boss01:pwd:supervisor:u_1002;viewer01:pwd:viewer:u_1003;admin01:pwd:admin:u_1004

# --- 2) Redis 多实例限流 ---
AGENT_RATE_LIMIT_BACKEND=redis
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_RATE_LIMIT_PER_MIN=60

# --- 3) 企微 webhook（本地接收器）---
AGENT_WECOM_WEBHOOK=http://127.0.0.1:8081/webhook
AGENT_SLA_NOTIFY=1
AGENT_SLA_NOTIFY_RETRIES=2
AGENT_SLA_SCHEDULER=manual
AGENT_DESK_BASE_URL=http://localhost:8000

# --- 4) Postgres 租约锁 ---
AGENT_LOCK_BACKEND=pg
AGENT_PG_DSN=postgresql://ecom_agent:ecom_agent@127.0.0.1:5432/ecom_agent
AGENT_LOCK_LEASE_SECONDS=120

# --- 5) 真实 embedding（Ollama 本地模型）---
AGENT_RERANK=embedding
AGENT_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
AGENT_EMBEDDING_API_KEY=ollama
AGENT_EMBEDDING_MODEL=nomic-embed-text
AGENT_EMBEDDING_TIMEOUT=30

# --- 6) 支付网关回调验签与对账 ---
AGENT_REFUND_API_URL=http://127.0.0.1:8082/refunds
AGENT_REFUND_API_SECRET=local-api-secret
AGENT_REFUND_CALLBACK_SECRET=local-callback-secret
AGENT_REFUND_CALLBACK_TOLERANCE=300
