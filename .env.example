# ===== 运行模式（第 8 周部署时改这里，不用改代码）=====
# rules = 离线规则模式，不需要任何密钥，开箱可跑（默认）
# llm   = 接入真实大模型（OpenAI 兼容接口）
AGENT_LLM_MODE=rules

# multi = Supervisor + 接待/政策/售后 三个 Agent
# single = 单 Agent 兜底版本（第 7 周评测用）
AGENT_MODE=multi

# ===== 大模型配置（AGENT_LLM_MODE=llm 时才生效）=====
# 实测 Token 只从 /chat/completions 响应的 usage 字段采集；
# 响应缺 usage 或调用失败降级时，只有 prompt 字符估算且不计费用。
#
# 示例 A：OpenAI 官方
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
# 示例 B：诺联 API / NuoAPI 等 OpenAI 兼容聚合网关
#   LLM_BASE_URL=https://<你的站点域名>/v1   ← 域名以浏览器地址栏为准，模型名照抄模型广场
#   LLM_MODEL=claude-haiku-4-5
#   LLM_PRICE_MULTIPLIER=0.3               ← 控制台该令牌分组显示的倍率
# 填好后先跑 python scripts/check_llm.py 自检，通过再启动服务。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# ===== 多模型路由：理解层用免费模型，表达层继续用主模型（可选）=====
# 意图识别只输出一个 JSON，任务轻，可用免费模型；话术润色继续用上面的主模型。
# 三个 CLASSIFY_* 必须同时填齐才生效，缺任意一个则理解层自动跟随主模型。
# 填好后先跑 python scripts/check_llm.py --role classify 自检。
#
# 示例 A：智谱 GLM-4-Flash（永久免费，128K，国内直连，推荐）
#   CLASSIFY_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   CLASSIFY_MODEL=glm-4-flash-250414   ← 当前可用版本；旧别名 glm-4-flash 也可用
#   CLASSIFY_PRICE_IN_PER_1K=0          ← 免费模型填 0，避免虚报费用
#   CLASSIFY_PRICE_OUT_PER_1K=0
#   glm-4.7-flash 也免费，但高峰可能返回 429「访问量过大」，稳定优先用 250414 版本
# 示例 B：硅基流动免费小模型
#   CLASSIFY_BASE_URL=https://api.siliconflow.cn/v1
#   CLASSIFY_MODEL=Qwen/Qwen3-8B
#   CLASSIFY_PRICE_IN_PER_1K=0
#   CLASSIFY_PRICE_OUT_PER_1K=0
# 示例 C：本地 Ollama（完全免费，需本机装 Ollama 并拉模型）
#   CLASSIFY_BASE_URL=http://localhost:11434/v1
#   CLASSIFY_MODEL=qwen2.5:7b
#   CLASSIFY_API_KEY=ollama             ← 随便填，Ollama 不校验
#   CLASSIFY_PRICE_IN_PER_1K=0
#   CLASSIFY_PRICE_OUT_PER_1K=0
CLASSIFY_BASE_URL=
CLASSIFY_API_KEY=
CLASSIFY_MODEL=
CLASSIFY_TIMEOUT=30
# 理解层单价：免费模型填 0；留空则按模型名查参考价目表（免费模型内置为 0）
CLASSIFY_PRICE_IN_PER_1K=
CLASSIFY_PRICE_OUT_PER_1K=

# ===== Token 计费单价（人民币 / 每 1K tokens）=====
# 留空 = 用 app/usage.py 的内置参考价目表（示例值，非官方账单）；
# 两者都没有时只报实测 token、不报金额（estimated_cost_cny = null）。
# 费用是按单价换算的估算值，实际以供应商账单为准。
LLM_PRICE_IN_PER_1K=
LLM_PRICE_OUT_PER_1K=
# 聚合网关倍率（如 0.3 表示按官方价 30% 计费）；留空或 1 = 不乘倍率
LLM_PRICE_MULTIPLIER=

# ===== 数据与持久化 =====
DB_PATH=./data/agent.db
# 固定"今天"便于演示与回归测试，留空则使用系统日期
AGENT_TODAY=

# ===== 订单源接入（默认 json，零配置演示不变）=====
# json = 读 ORDERS_PATH（默认 app/data/orders.json）；csv = 直接读平台导出表；
# http = 真实订单 API 通用骨架（GET JSON + Bearer token）。
AGENT_ORDER_SOURCE=json
# csv/http 时的来源；留空则沿用 ORDERS_PATH
AGENT_ORDER_SOURCE_PATH=
# http 模式必填：返回订单数组，或 {"orders":[...]} / {"data":[...]} / {"items":[...]}
AGENT_ORDER_SOURCE_URL=
AGENT_ORDER_SOURCE_TOKEN=
AGENT_ORDER_SOURCE_TIMEOUT=5
# 平台渠道标识（订单表未给 channel 时使用）
AGENT_ORDER_SOURCE_CHANNEL=DOUYIN
# JSON 对象：内部字段 → 平台字段/表头，例如 {"order_id":"out_order_no","user_id":"buyer_open_id"}
# user_id 必须映射到本系统登录身份；缺失或状态无法识别的订单会被整批拒绝。
AGENT_ORDER_SOURCE_FIELD_MAP=
# 离线导入示例：python scripts/import_orders.py --input app/data/orders_douyin_sample.csv --dry-run

# ===== 业务规则 =====
RETURN_WINDOW_DAYS=7
QUALITY_WINDOW_DAYS=15

# ===== 异常演练（第 6 / 第 8 周验收用）=====
# 1 = 建单成功后丢弃一次响应，用于验证幂等重试返回原工单
SIMULATE_RESPONSE_LOSS=0
# 1 = 物流工具固定超时，用于验证异常降级
SIMULATE_TOOL_TIMEOUT=0

# ===== 表达层事实校验（第 2 周「接大模型」的硬约束）=====
# 1 = polish 输出与代码模板不对齐时整体回退模板（默认开，强烈建议保持）
# 0 = 关闭护栏，仅用于对照演示模型幻觉，切勿在生产关闭
AGENT_GROUNDING=1

# ===== 身份与确认令牌 =====
# 留空 = demo 模式：显式传 user_id，但查询接口仍强制归属校验（适合课程演示）
# 配置后 = signed 模式：user_id 只从 /api/auth/token 签发的 HMAC 签名 token 解析
AGENT_AUTH_SECRET=
AUTH_TTL_SECONDS=86400
# 确认令牌有效期（秒）；超时后须重新核单，建单前还会再复核一次资格
CONFIRM_TOKEN_TTL_SECONDS=600

# ===== 安全底座（可选，默认全关，演示零配置）=====
# strict 模式：先配 AGENT_AUTH_SECRET，再打开 AGENT_RBAC_ENABLED 并填账号表
# 账号格式：工号:密码:角色[:user_id]，多个用分号分隔；角色 viewer/agent/supervisor/admin
# 建议演示账号：viewer01:pwd1:viewer:u_1001;agent01:pwd2:agent:u_1001;boss01:pwd3:supervisor:u_1001;admin01:pwd4:admin:u_1001
AGENT_RBAC_ENABLED=0
AGENT_STAFF_ACCOUNTS=
STAFF_TTL_SECONDS=28800
# 限流：0=关闭；可给全局或单接口设每分钟上限（按客户端 IP 计数）
AGENT_RATE_LIMIT_PER_MIN=0
AGENT_RATE_LIMIT_CHAT=0
AGENT_RATE_LIMIT_AUTH=0
AGENT_RATE_LIMIT_SWITCH=0

# ===== 产品闭环：SLA 超时通知（可选，默认关闭）=====
# 企业微信群机器人 webhook：填完整 URL 或机器人 key 均可。
# 留空 = notifier_configured=false，通知静默关闭、不会向外发请求（零配置演示安全）。
# 触发时机：拉取坐席队列时检测到「本次新超时」记录才推送，天然去重不刷屏；
# 也可手动调 POST /api/desk/sla-check，或挂定时任务。
# 消息卡片经 events.sanitize 脱敏；webhook 失败只记 sla_breach 事件，不阻断主流程。
AGENT_WECOM_WEBHOOK=
# 0 = 关停推送（webhook 仍可保留）；1 = 开启（需 webhook 非空才生效）
AGENT_SLA_NOTIFY=1
# 未认领超时阈值（分钟），与 AgentDesk.SLA_MINUTES 对齐
AGENT_SLA_ALERT_MINUTES=5

# ===== 架构进阶（三项默认零配置，配置后才切换后端）=====
# 1) 检索重排：off = 纯 BM25（默认，行为与课程基线完全一致）
#    hybrid = BM25 召回宽候选池 + hashing 向量 cosine 融合重排（纯 stdlib、确定性）
#    权重 0~1，越大越偏向向量相似度；两侧分数已池内归一化，权重真实生效
AGENT_RERANK=off
AGENT_RERANK_WEIGHT=0.4

# 2) 会话锁：inprocess = 单进程内锁（默认）；db = 数据库租约锁（跨进程互斥）
#    db 后端跑在现有 SQLite 上，SQL 与 Postgres 同构但项目未内置 psycopg 驱动。
#    租约默认 30s（LLM 单轮实测可达 69s，按实际调大；持锁期间后台自动续期）
AGENT_LOCK_BACKEND=inprocess
AGENT_LOCK_LEASE_SECONDS=30
AGENT_LOCK_WAIT_SECONDS=5

# 3) 退款网关：留空 = 沙箱网关（确定性成功、不向外发请求、不发生真实资金流转）
#    填 URL 才走 HTTP：HMAC-SHA256 签名 + Idempotency-Key，超时/失败降级不推进状态
#    幂等键由服务端固定为 refund:<ticket_id>，调用方无法换 key 重复打款
AGENT_REFUND_API_URL=
AGENT_REFUND_API_SECRET=
AGENT_REFUND_TIMEOUT=5

# ===== 外部依赖接入（六项骨架已就绪；留空 = 零配置沙箱，不改则演示行为不变）=====
# 说明：以下实现全部纯标准库 + 注入式客户端，不装任何可选包也能跑；
#       真实联调时才需要外部资源（IdP / Redis / Postgres / embedding / 企微 / 支付网关）。
# 本地一键替身：docker compose -f docker-compose.local.yml up -d
# 参数模板见 deploy/local/.env.local.example；用 scripts/local_stubs/run_local_app.py 启动可不改本文件。

# --- 1) 真实 IdP / SSO ---
# account = 演示账号表（默认）；sso = HMAC 签名码沙箱；oidc = 真 OIDC id_token 验签
# oidc 模式：前端完成授权码流程后，把 id_token 放到 /api/auth/login 的 password 字段。
# issuer/audience 必填；jwks_url 留空则自动从 <issuer>/.well-known/openid-configuration 发现。
AGENT_IDP_PROVIDER=account
AGENT_OIDC_ISSUER=
AGENT_OIDC_AUDIENCE=
AGENT_OIDC_JWKS_URL=

# --- 2) Redis 多实例限流（可选依赖：pip install redis）---
# backend=memory（默认，进程内）| redis（多实例共享计数，需 Redis 实例）
# 注意：AGENT_RATE_LIMIT_PER_MIN=0 表示关闭，启用限流时必须设非零值！
AGENT_RATE_LIMIT_BACKEND=memory
AGENT_REDIS_URL=redis://127.0.0.1:6379/0

# --- 3) 企微 webhook 通知重试（默认 0 次；失败仍只记事件、不阻断主流程）---
AGENT_SLA_NOTIFY_RETRIES=0

# --- 4) Postgres 租约锁（可选依赖：pip install 'psycopg[binary]'）---
# backend=inprocess（默认）| db（SQLite 租约，跨进程）| pg（Postgres 租约，需驱动）
# 显式配置 pg 但驱动缺失会直接报错，绝不静默退回进程内锁（避免破坏会话串行化）。
AGENT_LOCK_BACKEND=inprocess
AGENT_PG_DSN=postgresql://user:pass@localhost:5432/ecom_agent

# --- 5) 真实 embedding 语义重排 ---
# AGENT_RERANK=embedding 需填 base_url（OpenAI 兼容 /v1），留空则降级 hashing 重排。
# 服务不可用时自动退回 BM25 原序，不阻断检索。
AGENT_EMBEDDING_BASE_URL=
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=text-embedding-3-small
AGENT_EMBEDDING_TIMEOUT=5

# --- 6) 支付网关回调验签与对账 ---
# 回调签名口径：HMAC-SHA256(secret, timestamp + "." + raw_body)，
# 请求头 X-Refund-Signature / X-Refund-Timestamp；验签通过也只记事件交人工复核，
# 绝不自动推进状态或二次打款。对账用 POST /api/refund/reconcile 上传 CSV/JSON。
AGENT_REFUND_CALLBACK_SECRET=
AGENT_REFUND_CALLBACK_TOLERANCE=300
